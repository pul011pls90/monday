      "topics": [
        {
          "id": "angles_and_radians",
          "name": "Angles and radians",
          "bank": "trig",
          "formulas": [
            {
              "id": "deg_rad",
              "name": "Degrees and radians",
              "en": "Basic",
              "tex": "\\text{rad} = \\text{deg} \\cdot \\frac{\\pi}{180} \\;;\\; \\text{deg} = \\text{rad} \\cdot \\frac{180}{\\pi}",
              "examples": [
                {
                  "q": "Convert $135^\\circ$ to radians.",
                  "goal": "Converts between the two angle units. $\\pi\\text{ rad} = 180^\\circ$.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$135 \\cdot \\frac{\\pi}{180} = \\frac{3\\pi}{4}$."
                  ],
                  "answer": "$\\frac{3\\pi}{4}$"
                }
              ]
            },
            {
              "id": "arc_sector",
              "name": "Arc length and sector area",
              "en": "Basic",
              "tex": "s = r\\theta \\;;\\; A = \\frac{1}{2}r^2\\theta",
              "examples": [
                {
                  "q": "$r = 6$, $\\theta = \\frac{\\pi}{3}$. Find $s$ and $A$.",
                  "goal": "Valid only when $\\theta$ is in radians.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$s = 6 \\cdot \\frac{\\pi}{3} = 2\\pi$, $A = \\frac{1}{2} \\cdot 36 \\cdot \\frac{\\pi}{3} = 6\\pi$."
                  ],
                  "answer": "$s = 2\\pi,\\; A = 6\\pi$"
                }
              ]
            }
          ]
        },
        {
          "id": "right_triangle_definitions",
          "name": "Right-triangle definitions",
          "bank": "trig",
          "formulas": [
            {
              "id": "right_triangle",
              "name": "Right-triangle definitions",
              "en": "Basic",
              "tex": "\\sin\\theta = \\frac{\\text{opposite}}{\\text{hypotenuse}} \\;;\\; \\cos\\theta = \\frac{\\text{adjacent}}{\\text{hypotenuse}} \\;;\\; \\tan\\theta = \\frac{\\text{opposite}}{\\text{adjacent}}",
              "examples": [
                {
                  "q": "Legs $3$ and $4$, hypotenuse $5$. $\\theta$ is opposite the leg $3$. Find $\\sin\\theta$, $\\cos\\theta$, $\\tan\\theta$.",
                  "goal": "Defines the three basic ratios for an acute angle $\\theta$.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\sin\\theta = \\frac{3}{5}$, $\\cos\\theta = \\frac{4}{5}$, $\\tan\\theta = \\frac{3}{4}$."
                  ],
                  "answer": "$\\sin\\theta = \\frac{3}{5},\\; \\cos\\theta = \\frac{4}{5},\\; \\tan\\theta = \\frac{3}{4}$"
                }
              ]
            },
            {
              "id": "reciprocal_quotient",
              "name": "Reciprocal and quotient identities",
              "en": "Basic",
              "tex": "\\csc\\theta = \\frac{1}{\\sin\\theta},\\; \\sec\\theta = \\frac{1}{\\cos\\theta},\\; \\cot\\theta = \\frac{1}{\\tan\\theta} \\;;\\; \\tan\\theta = \\frac{\\sin\\theta}{\\cos\\theta},\\; \\cot\\theta = \\frac{\\cos\\theta}{\\sin\\theta}",
              "examples": [
                {
                  "q": "$\\cos\\theta = \\frac{5}{13}$. Find $\\sec\\theta$.",
                  "goal": "Expresses all six functions through sine and cosine.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\sec\\theta = \\frac{1}{5/13} = \\frac{13}{5}$."
                  ],
                  "answer": "$\\frac{13}{5}$"
                }
              ]
            },
            {
              "id": "special_values",
              "name": "Special angle values",
              "en": "Basic",
              "tex": "\\theta: 0^\\circ,\\, 30^\\circ,\\, 45^\\circ,\\, 60^\\circ,\\, 90^\\circ \\;;\\; \\sin\\theta: 0,\\, \\frac{1}{2},\\, \\frac{\\sqrt{2}}{2},\\, \\frac{\\sqrt{3}}{2},\\, 1 \\;;\\; \\cos\\theta: 1,\\, \\frac{\\sqrt{3}}{2},\\, \\frac{\\sqrt{2}}{2},\\, \\frac{1}{2},\\, 0 \\;;\\; \\tan\\theta: 0,\\, \\frac{\\sqrt{3}}{3},\\, 1,\\, \\sqrt{3},\\, \\text{undef.}",
              "examples": [
                {
                  "q": "Evaluate $\\sin 60^\\circ \\cdot \\cos 30^\\circ$.",
                  "goal": "Exact values used throughout school and exam problems.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\frac{\\sqrt{3}}{2} \\cdot \\frac{\\sqrt{3}}{2} = \\frac{3}{4}$."
                  ],
                  "answer": "$\\frac{3}{4}$"
                }
              ]
            }
          ]
        },
        {
          "id": "unit_circle",
          "name": "Unit circle",
          "bank": "trig",
          "formulas": [
            {
              "id": "unit_circle",
              "name": "Unit circle and signs by quadrant",
              "en": "Basic",
              "tex": "P(\\theta) = (\\cos\\theta, \\sin\\theta) \\;;\\; \\text{I: all}>0,\\; \\text{II: }\\sin>0,\\; \\text{III: }\\tan>0,\\; \\text{IV: }\\cos>0",
              "examples": [
                {
                  "q": "Find $\\sin\\frac{5\\pi}{6}$ and $\\cos\\frac{5\\pi}{6}$.",
                  "goal": "Sine is the y-coordinate and cosine is the x-coordinate. Use the reference angle for magnitude and the quadrant for sign.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "Quadrant II, reference angle $\\frac{\\pi}{6}$: $\\sin = \\frac{1}{2}$, $\\cos = -\\frac{\\sqrt{3}}{2}$."
                  ],
                  "answer": "$\\sin = \\frac{1}{2},\\; \\cos = -\\frac{\\sqrt{3}}{2}$"
                }
              ]
            },
            {
              "id": "periodicity",
              "name": "Periodicity",
              "en": "Basic",
              "tex": "\\sin(\\theta + 2\\pi k) = \\sin\\theta,\\; \\cos(\\theta + 2\\pi k) = \\cos\\theta \\;;\\; \\tan(\\theta + \\pi k) = \\tan\\theta \\quad (k \\in \\mathbb{Z})",
              "examples": [
                {
                  "q": "Evaluate $\\sin 405^\\circ$.",
                  "goal": "Sine and cosine repeat every $2\\pi$. Tangent and cotangent repeat every $\\pi$.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$405^\\circ = 360^\\circ + 45^\\circ$, so $\\sin 405^\\circ = \\sin 45^\\circ = \\frac{\\sqrt{2}}{2}$."
                  ],
                  "answer": "$\\frac{\\sqrt{2}}{2}$"
                }
              ]
            },
            {
              "id": "even_odd",
              "name": "Even and odd properties",
              "en": "Basic",
              "tex": "\\sin(-\\theta) = -\\sin\\theta \\;;\\; \\cos(-\\theta) = \\cos\\theta \\;;\\; \\tan(-\\theta) = -\\tan\\theta",
              "examples": [
                {
                  "q": "Evaluate $\\cos\\!\\left(-\\frac{\\pi}{3}\\right)$ and $\\tan\\!\\left(-\\frac{\\pi}{4}\\right)$.",
                  "goal": "Cosine is even. Sine, tangent, and cotangent are odd.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\cos(-\\frac{\\pi}{3}) = \\cos\\frac{\\pi}{3} = \\frac{1}{2}$; $\\tan(-\\frac{\\pi}{4}) = -\\tan\\frac{\\pi}{4} = -1$."
                  ],
                  "answer": "$\\frac{1}{2}$ and $-1$"
                }
              ]
            }
          ]
        },
        {
          "id": "fundamental_identities",
          "name": "Fundamental identities",
          "bank": "trig",
          "formulas": [
            {
              "id": "pythagorean",
              "name": "Pythagorean identities",
              "en": "Basic",
              "tex": "\\sin^2\\theta + \\cos^2\\theta = 1 \\;;\\; 1 + \\tan^2\\theta = \\sec^2\\theta \\;;\\; 1 + \\cot^2\\theta = \\csc^2\\theta",
              "examples": [
                {
                  "q": "$\\sin\\theta = \\frac{3}{5}$, $\\theta$ in Quadrant II. Find $\\cos\\theta$.",
                  "goal": "Follow from $x^2 + y^2 = 1$ on the unit circle. Used to find one function from another.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\cos^2\\theta = 1 - \\frac{9}{25} = \\frac{16}{25}$. Quadrant II gives $\\cos\\theta = -\\frac{4}{5}$."
                  ],
                  "answer": "$-\\frac{4}{5}$"
                }
              ]
            },
            {
              "id": "cofunction",
              "name": "Cofunction identities",
              "en": "Basic",
              "tex": "\\sin(90^\\circ - \\theta) = \\cos\\theta \\;;\\; \\cos(90^\\circ - \\theta) = \\sin\\theta \\;;\\; \\tan(90^\\circ - \\theta) = \\cot\\theta",
              "examples": [
                {
                  "q": "Write $\\sin 70^\\circ$ as a cosine.",
                  "goal": "A function of an angle equals the cofunction of its complement.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\sin 70^\\circ = \\cos(90^\\circ - 70^\\circ) = \\cos 20^\\circ$."
                  ],
                  "answer": "$\\cos 20^\\circ$"
                }
              ]
            }
          ]
        },
        {
          "id": "reduction_formulas",
          "name": "Reduction formulas",
          "bank": "trig",
          "formulas": [
            {
              "id": "reduction",
              "name": "Reduction formulas",
              "en": "Intermediate",
              "tex": "\\sin(\\pi - \\theta) = \\sin\\theta,\\; \\cos(\\pi - \\theta) = -\\cos\\theta,\\; \\tan(\\pi - \\theta) = -\\tan\\theta \\;;\\; \\sin(\\pi + \\theta) = -\\sin\\theta,\\; \\cos(\\pi + \\theta) = -\\cos\\theta,\\; \\tan(\\pi + \\theta) = \\tan\\theta \\;;\\; \\sin(2\\pi - \\theta) = -\\sin\\theta,\\; \\cos(2\\pi - \\theta) = \\cos\\theta,\\; \\tan(2\\pi - \\theta) = -\\tan\\theta \\;;\\; \\sin\\!\\left(\\frac{\\pi}{2}+\\theta\\right)=\\cos\\theta,\\; \\cos\\!\\left(\\frac{\\pi}{2}+\\theta\\right)=-\\sin\\theta",
              "examples": [
                {
                  "q": "Evaluate $\\cos 120^\\circ$.",
                  "goal": "Reduces any angle to an acute angle. Determine the sign from the quadrant of the original angle.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\cos 120^\\circ = \\cos(180^\\circ - 60^\\circ) = -\\cos 60^\\circ = -\\frac{1}{2}$."
                  ],
                  "answer": "$-\\frac{1}{2}$"
                }
              ]
            }
          ]
        },
        {
          "id": "sum_and_difference",
          "name": "Sum and difference",
          "bank": "trig",
          "formulas": [
            {
              "id": "sum_difference",
              "name": "Sum and difference formulas",
              "en": "Intermediate",
              "tex": "\\sin(A \\pm B) = \\sin A\\cos B \\pm \\cos A\\sin B \\;;\\; \\cos(A \\pm B) = \\cos A\\cos B \\mp \\sin A\\sin B \\;;\\; \\tan(A \\pm B) = \\frac{\\tan A \\pm \\tan B}{1 \\mp \\tan A\\tan B}",
              "examples": [
                {
                  "q": "Find $\\sin 75^\\circ$.",
                  "goal": "Note the sign change in the cosine formula. Used to obtain exact values of non-special angles.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\sin(45^\\circ + 30^\\circ) = \\frac{\\sqrt{2}}{2}\\cdot\\frac{\\sqrt{3}}{2} + \\frac{\\sqrt{2}}{2}\\cdot\\frac{1}{2} = \\frac{\\sqrt{6}+\\sqrt{2}}{4}$."
                  ],
                  "answer": "$\\frac{\\sqrt{6}+\\sqrt{2}}{4}$"
                }
              ]
            },
            {
              "id": "auxiliary_angle",
              "name": "Auxiliary angle (harmonic) form",
              "en": "Intermediate",
              "tex": "a\\sin x + b\\cos x = R\\sin(x + \\varphi) \\;;\\; R = \\sqrt{a^2 + b^2},\\; \\cos\\varphi = \\frac{a}{R},\\; \\sin\\varphi = \\frac{b}{R}",
              "examples": [
                {
                  "q": "Write $\\sin x + \\cos x$ as a single sine and find its maximum.",
                  "goal": "Combines a sine and a cosine of the same angle into one sine. Gives maximum $R$ and minimum $-R$.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$R = \\sqrt{2}$, $\\varphi = \\frac{\\pi}{4}$. $\\sin x + \\cos x = \\sqrt{2}\\sin(x + \\frac{\\pi}{4})$, max $\\sqrt{2}$."
                  ],
                  "answer": "$\\sqrt{2}\\sin(x+\\frac{\\pi}{4})$, max $\\sqrt{2}$"
                }
              ]
            }
          ]
        },
        {
          "id": "multiple_angle_and_half_angle",
          "name": "Multiple-angle and half-angle",
          "bank": "trig",
          "formulas": [
            {
              "id": "double_angle",
              "name": "Double-angle formulas",
              "en": "Intermediate",
              "tex": "\\sin 2\\theta = 2\\sin\\theta\\cos\\theta \\;;\\; \\cos 2\\theta = \\cos^2\\theta - \\sin^2\\theta = 2\\cos^2\\theta - 1 = 1 - 2\\sin^2\\theta \\;;\\; \\tan 2\\theta = \\frac{2\\tan\\theta}{1 - \\tan^2\\theta}",
              "examples": [
                {
                  "q": "$\\sin\\theta = \\frac{3}{5}$, $\\cos\\theta = \\frac{4}{5}$. Find $\\sin 2\\theta$ and $\\cos 2\\theta$.",
                  "goal": "Special case of the sum formulas with $A = B = \\theta$. Choose the cosine form matching the given quantity.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\sin 2\\theta = 2 \\cdot \\frac{3}{5} \\cdot \\frac{4}{5} = \\frac{24}{25}$, $\\cos 2\\theta = 1 - 2 \\cdot \\frac{9}{25} = \\frac{7}{25}$."
                  ],
                  "answer": "$\\sin 2\\theta = \\frac{24}{25},\\; \\cos 2\\theta = \\frac{7}{25}$"
                }
              ]
            },
            {
              "id": "half_angle",
              "name": "Half-angle formulas",
              "en": "Intermediate",
              "tex": "\\sin\\frac{\\theta}{2} = \\pm\\sqrt{\\frac{1 - \\cos\\theta}{2}} \\;;\\; \\cos\\frac{\\theta}{2} = \\pm\\sqrt{\\frac{1 + \\cos\\theta}{2}} \\;;\\; \\tan\\frac{\\theta}{2} = \\frac{\\sin\\theta}{1 + \\cos\\theta} = \\frac{1 - \\cos\\theta}{\\sin\\theta}",
              "examples": [
                {
                  "q": "Find $\\cos 15^\\circ$.",
                  "goal": "The sign of the root is set by the quadrant of $\\theta/2$.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\cos 15^\\circ = \\sqrt{\\frac{1+\\cos 30^\\circ}{2}} = \\sqrt{\\frac{2+\\sqrt{3}}{4}} = \\frac{\\sqrt{6}+\\sqrt{2}}{4}$."
                  ],
                  "answer": "$\\frac{\\sqrt{6}+\\sqrt{2}}{4}$"
                }
              ]
            },
            {
              "id": "power_reducing",
              "name": "Power-reducing formulas",
              "en": "Intermediate",
              "tex": "\\sin^2\\theta = \\frac{1 - \\cos 2\\theta}{2} \\;;\\; \\cos^2\\theta = \\frac{1 + \\cos 2\\theta}{2} \\;;\\; \\tan^2\\theta = \\frac{1 - \\cos 2\\theta}{1 + \\cos 2\\theta}",
              "examples": [
                {
                  "q": "Evaluate $\\cos^2\\frac{\\pi}{8}$.",
                  "goal": "Rewrites squares of sine and cosine without powers. Essential for integration.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\frac{1 + \\cos(\\pi/4)}{2} = \\frac{1 + \\sqrt{2}/2}{2} = \\frac{2+\\sqrt{2}}{4}$."
                  ],
                  "answer": "$\\frac{2+\\sqrt{2}}{4}$"
                }
              ]
            },
            {
              "id": "triple_angle",
              "name": "Triple-angle formulas",
              "en": "Intermediate",
              "tex": "\\sin 3\\theta = 3\\sin\\theta - 4\\sin^3\\theta \\;;\\; \\cos 3\\theta = 4\\cos^3\\theta - 3\\cos\\theta",
              "examples": [
                {
                  "q": "$\\sin\\theta = \\frac{1}{2}$. Find $\\sin 3\\theta$.",
                  "goal": "Expresses a triple angle through powers of a single function.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$3 \\cdot \\frac{1}{2} - 4 \\cdot \\frac{1}{8} = \\frac{3}{2} - \\frac{1}{2} = 1$."
                  ],
                  "answer": "$1$"
                }
              ]
            }
          ]
        },
        {
          "id": "product_to_sum_and_sum_to_product",
          "name": "Product-to-sum and sum-to-product",
          "bank": "trig",
          "formulas": [
            {
              "id": "product_to_sum",
              "name": "Product-to-sum formulas",
              "en": "Intermediate",
              "tex": "\\sin A\\cos B = \\frac{1}{2}[\\sin(A+B) + \\sin(A-B)] \\;;\\; \\cos A\\cos B = \\frac{1}{2}[\\cos(A-B) + \\cos(A+B)] \\;;\\; \\sin A\\sin B = \\frac{1}{2}[\\cos(A-B) - \\cos(A+B)]",
              "examples": [
                {
                  "q": "Evaluate $\\sin 75^\\circ \\cos 15^\\circ$.",
                  "goal": "Converts a product into a sum. Used to simplify expressions and integrate products.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\frac{1}{2}[\\sin 90^\\circ + \\sin 60^\\circ] = \\frac{1}{2}(1 + \\frac{\\sqrt{3}}{2}) = \\frac{2+\\sqrt{3}}{4}$."
                  ],
                  "answer": "$\\frac{2+\\sqrt{3}}{4}$"
                }
              ]
            },
            {
              "id": "sum_to_product",
              "name": "Sum-to-product formulas",
              "en": "Intermediate",
              "tex": "\\sin A + \\sin B = 2\\sin\\frac{A+B}{2}\\cos\\frac{A-B}{2} \\;;\\; \\sin A - \\sin B = 2\\cos\\frac{A+B}{2}\\sin\\frac{A-B}{2} \\;;\\; \\cos A + \\cos B = 2\\cos\\frac{A+B}{2}\\cos\\frac{A-B}{2} \\;;\\; \\cos A - \\cos B = -2\\sin\\frac{A+B}{2}\\sin\\frac{A-B}{2}",
              "examples": [
                {
                  "q": "Evaluate $\\sin 75^\\circ + \\sin 15^\\circ$.",
                  "goal": "Converts a sum into a product. Used to factor expressions and solve equations.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$2\\sin 45^\\circ\\cos 30^\\circ = 2 \\cdot \\frac{\\sqrt{2}}{2} \\cdot \\frac{\\sqrt{3}}{2} = \\frac{\\sqrt{6}}{2}$."
                  ],
                  "answer": "$\\frac{\\sqrt{6}}{2}$"
                }
              ]
            }
          ]
        },
        {
          "id": "graphs_of_trigonometric_functions",
          "name": "Graphs of trigonometric functions",
          "bank": "trig",
          "formulas": [
            {
              "id": "graph_transformations",
              "name": "Sinusoidal graph parameters",
              "en": "Intermediate",
              "tex": "y = A\\sin(B(x - C)) + D \\;;\\; \\text{Amplitude} = |A|,\\; \\text{Period} = \\frac{2\\pi}{|B|}\\; (\\tan:\\frac{\\pi}{|B|}) \\;;\\; \\text{Phase shift} = C,\\; \\text{Midline: } y = D",
              "examples": [
                {
                  "q": "Analyse $y = 3\\sin(2x - \\pi) + 1$.",
                  "goal": "Reads the shape of a sine or cosine graph directly from its equation.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$y = 3\\sin(2(x - \\frac{\\pi}{2})) + 1$: amplitude $3$, period $\\pi$, shift $\\frac{\\pi}{2}$ right, midline $y=1$, range $[-2, 4]$."
                  ],
                  "answer": "Amplitude $3$, period $\\pi$, shift $\\frac{\\pi}{2}$ right, midline $y=1$, range $[-2, 4]$"
                }
              ]
            }
          ]
        },
        {
          "id": "inverse_trigonometric_functions",
          "name": "Inverse trigonometric functions",
          "bank": "trig",
          "formulas": [
            {
              "id": "inverse_trig",
              "name": "Inverse trigonometric functions",
              "en": "Intermediate",
              "tex": "\\arcsin: [-1, 1] \\to \\left[-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right],\\; \\arccos: [-1, 1] \\to [0, \\pi],\\; \\arctan: \\mathbb{R} \\to \\left(-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right) \\;;\\; \\arcsin x + \\arccos x = \\frac{\\pi}{2} \\;;\\; \\arcsin(-x) = -\\arcsin x,\\; \\arccos(-x) = \\pi - \\arccos x,\\; \\arctan(-x) = -\\arctan x",
              "examples": [
                {
                  "q": "Evaluate $\\arcsin\\!\\left(-\\frac{1}{2}\\right)$ and $\\arccos\\!\\left(-\\frac{1}{2}\\right)$.",
                  "goal": "Each inverse returns a single angle from its restricted range.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\arcsin(-\\frac{1}{2}) = -\\frac{\\pi}{6}$; $\\arccos(-\\frac{1}{2}) = \\pi - \\frac{\\pi}{3} = \\frac{2\\pi}{3}$."
                  ],
                  "answer": "$-\\frac{\\pi}{6}$ and $\\frac{2\\pi}{3}$"
                }
              ]
            }
          ]
        },
        {
          "id": "trigonometric_equations",
          "name": "Trigonometric equations",
          "bank": "trig",
          "formulas": [
            {
              "id": "trig_equations",
              "name": "Solutions of basic trigonometric equations",
              "en": "Intermediate",
              "tex": "\\sin x = a \\Rightarrow x = (-1)^n \\arcsin a + \\pi n \\;;\\; \\cos x = a \\Rightarrow x = \\pm\\arccos a + 2\\pi n \\;;\\; \\tan x = a \\Rightarrow x = \\arctan a + \\pi n \\;;\\; \\sin x = 0 \\Rightarrow \\pi n,\\; \\sin x = 1 \\Rightarrow \\frac{\\pi}{2}+2\\pi n,\\; \\sin x = -1 \\Rightarrow -\\frac{\\pi}{2}+2\\pi n \\;;\\; \\cos x = 0 \\Rightarrow \\frac{\\pi}{2}+\\pi n,\\; \\cos x = 1 \\Rightarrow 2\\pi n,\\; \\cos x = -1 \\Rightarrow \\pi+2\\pi n",
              "examples": [
                {
                  "q": "Solve $2\\sin x = 1$.",
                  "goal": "General solutions ($n \\in \\mathbb{Z}$; $|a| \\le 1$ for $\\sin$ and $\\cos$).",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\sin x = \\frac{1}{2}$, so $x = (-1)^n\\frac{\\pi}{6} + \\pi n$ ($x = \\frac{\\pi}{6}+2\\pi n$ or $\\frac{5\\pi}{6}+2\\pi n$)."
                  ],
                  "answer": "$x = (-1)^n\\frac{\\pi}{6} + \\pi n$"
                }
              ]
            }
          ]
        },
        {
          "id": "triangle_laws",
          "name": "Triangle laws",
          "bank": "trig",
          "formulas": [
            {
              "id": "sine_rule",
              "name": "Law of sines",
              "en": "Intermediate",
              "tex": "\\frac{a}{\\sin A} = \\frac{b}{\\sin B} = \\frac{c}{\\sin C} = 2R",
              "examples": [
                {
                  "q": "$A = 30^\\circ$, $a = 5$, $B = 45^\\circ$. Find $b$.",
                  "goal": "Relates each side to the sine of the opposite angle ($R$ is the circumradius).",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$b = \\frac{a\\sin B}{\\sin A} = \\frac{5 \\cdot \\sqrt{2}/2}{1/2} = 5\\sqrt{2}$."
                  ],
                  "answer": "$5\\sqrt{2}$"
                }
              ]
            },
            {
              "id": "cosine_rule",
              "name": "Law of cosines",
              "en": "Intermediate",
              "tex": "c^2 = a^2 + b^2 - 2ab\\cos C \\;;\\; \\cos C = \\frac{a^2 + b^2 - c^2}{2ab}",
              "examples": [
                {
                  "q": "$a = 3$, $b = 4$, $C = 60^\\circ$. Find $c$.",
                  "goal": "Generalises the Pythagorean theorem for two sides and the included angle, or three sides.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$c^2 = 9 + 16 - 2 \\cdot 12 \\cdot \\frac{1}{2} = 13$, so $c = \\sqrt{13}$."
                  ],
                  "answer": "$\\sqrt{13}$"
                }
              ]
            },
            {
              "id": "triangle_area",
              "name": "Triangle area with sine",
              "en": "Intermediate",
              "tex": "\\text{Area} = \\frac{1}{2}ab\\sin C",
              "examples": [
                {
                  "q": "$a = 6$, $b = 8$, $C = 30^\\circ$. Find the area.",
                  "goal": "Area from two sides and the included angle.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\frac{1}{2} \\cdot 6 \\cdot 8 \\cdot \\sin 30^\\circ = 24 \\cdot \\frac{1}{2} = 12$."
                  ],
                  "answer": "$12$"
                }
              ]
            }
          ]
        },
        {
          "id": "limits",
          "name": "Limits",
          "bank": "trig",
          "formulas": [
            {
              "id": "trig_limits",
              "name": "Fundamental trigonometric limits",
              "en": "Calculus",
              "tex": "\\lim_{x\\to 0}\\frac{\\sin x}{x} = 1,\\; \\lim_{x\\to 0}\\frac{\\tan x}{x} = 1 \\;;\\; \\lim_{x\\to 0}\\frac{1-\\cos x}{x} = 0,\\; \\lim_{x\\to 0}\\frac{1-\\cos x}{x^2} = \\frac{1}{2} \\;;\\; \\lim_{x\\to 0}\\frac{\\sin(kx)}{x} = k",
              "examples": [
                {
                  "q": "Evaluate $\\lim_{x\\to 0}\\frac{\\sin 5x}{2x}$.",
                  "goal": "Valid with $x$ in radians. Used to resolve $0/0$ forms.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\frac{5}{2} \\cdot \\lim_{x\\to 0}\\frac{\\sin 5x}{5x} = \\frac{5}{2}$."
                  ],
                  "answer": "$\\frac{5}{2}$"
                }
              ]
            }
          ]
        },
        {
          "id": "derivatives",
          "name": "Derivatives",
          "bank": "trig",
          "formulas": [
            {
              "id": "trig_derivatives",
              "name": "Derivatives of trigonometric functions",
              "en": "Calculus",
              "tex": "(\\sin x)' = \\cos x,\\; (\\cos x)' = -\\sin x \\;;\\; (\\tan x)' = \\sec^2 x,\\; (\\cot x)' = -\\csc^2 x \\;;\\; (\\sec x)' = \\sec x\\tan x,\\; (\\csc x)' = -\\csc x\\cot x",
              "examples": [
                {
                  "q": "Differentiate $x\\sin x$.",
                  "goal": "Valid with $x$ in radians. Functions beginning with 'co' have negative derivatives.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "Product rule: $(x\\sin x)' = \\sin x + x\\cos x$."
                  ],
                  "answer": "$\\sin x + x\\cos x$"
                }
              ]
            },
            {
              "id": "inverse_trig_derivatives",
              "name": "Derivatives of inverse trigonometric functions",
              "en": "Calculus",
              "tex": "(\\arcsin x)' = \\frac{1}{\\sqrt{1 - x^2}},\\; (\\arccos x)' = -\\frac{1}{\\sqrt{1 - x^2}} \\;;\\; (\\arctan x)' = \\frac{1}{1 + x^2},\\; (\\text{arccot } x)' = -\\frac{1}{1 + x^2}",
              "examples": [
                {
                  "q": "Differentiate $\\arctan(2x)$.",
                  "goal": "Combine with the chain rule for composite arguments.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "Chain rule: $\\frac{2}{1 + (2x)^2} = \\frac{2}{1 + 4x^2}$."
                  ],
                  "answer": "$\\frac{2}{1 + 4x^2}$"
                }
              ]
            }
          ]
        },
        {
          "id": "integrals",
          "name": "Integrals",
          "bank": "trig",
          "formulas": [
            {
              "id": "trig_integrals_basic",
              "name": "Basic trigonometric integrals",
              "en": "Calculus",
              "tex": "\\int \\sin x\\,dx = -\\cos x + C,\\; \\int \\cos x\\,dx = \\sin x + C \\;;\\; \\int \\sec^2 x\\,dx = \\tan x + C,\\; \\int \\csc^2 x\\,dx = -\\cot x + C \\;;\\; \\int \\sec x\\tan x\\,dx = \\sec x + C,\\; \\int \\csc x\\cot x\\,dx = -\\csc x + C",
              "examples": [
                {
                  "q": "Evaluate $\\int (3\\cos x - \\sec^2 x)\\,dx$.",
                  "goal": "Direct reversals of the derivative table.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$3\\sin x - \\tan x + C$."
                  ],
                  "answer": "$3\\sin x - \\tan x + C$"
                }
              ]
            },
            {
              "id": "trig_integrals_log",
              "name": "Integrals of tan, cot, sec, csc",
              "en": "Calculus",
              "tex": "\\int \\tan x\\,dx = -\\ln|\\cos x| + C = \\ln|\\sec x| + C \\;;\\; \\int \\cot x\\,dx = \\ln|\\sin x| + C \\;;\\; \\int \\sec x\\,dx = \\ln|\\sec x + \\tan x| + C \\;;\\; \\int \\csc x\\,dx = -\\ln|\\csc x + \\cot x| + C",
              "examples": [
                {
                  "q": "Evaluate $\\int_0^{\\pi/4} \\tan x\\,dx$.",
                  "goal": "Logarithmic results. The first two follow from substitution $u = \\cos x$ and $u = \\sin x$.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$[-\\ln(\\cos x)]_0^{\\pi/4} = -\\ln\\frac{\\sqrt{2}}{2} = \\frac{1}{2}\\ln 2$."
                  ],
                  "answer": "$\\frac{1}{2}\\ln 2$"
                }
              ]
            },
            {
              "id": "inverse_trig_integrals",
              "name": "Integrals giving inverse trigonometric functions",
              "en": "Calculus",
              "tex": "\\int \\frac{dx}{\\sqrt{a^2 - x^2}} = \\arcsin\\frac{x}{a} + C \\;;\\; \\int \\frac{dx}{a^2 + x^2} = \\frac{1}{a}\\arctan\\frac{x}{a} + C \\quad (a > 0)",
              "examples": [
                {
                  "q": "Evaluate $\\int \\frac{dx}{9 + x^2}$.",
                  "goal": "Recognise the forms $\\sqrt{a^2 - x^2}$ and $a^2 + x^2$ in the denominator.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "With $a = 3$: $\\frac{1}{3}\\arctan\\frac{x}{3} + C$."
                  ],
                  "answer": "$\\frac{1}{3}\\arctan\\frac{x}{3} + C$"
                }
              ]
            },
            {
              "id": "trig_integrals_powers",
              "name": "Integrals of sin²x and cos²x",
              "en": "Calculus",
              "tex": "\\int \\sin^2 x\\,dx = \\frac{x}{2} - \\frac{\\sin 2x}{4} + C \\;;\\; \\int \\cos^2 x\\,dx = \\frac{x}{2} + \\frac{\\sin 2x}{4} + C",
              "examples": [
                {
                  "q": "Evaluate $\\int_0^{\\pi} \\cos^2 x\\,dx$.",
                  "goal": "Obtained with the power-reducing formulas.",
                  "plan": "",
                  "use": "",
                  "steps": [
                    "$\\left[\\frac{x}{2} + \\frac{\\sin 2x}{4}\\right]_0^{\\pi} = \\frac{\\pi}{2}$."
                  ],
                  "answer": "$\\frac{\\pi}{2}$"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
