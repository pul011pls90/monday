msgstr "Dushanba testi dushanba kuni soat 19:00 da ochiladi."

#: monday/student.py:1212
msgid "Профиль сохранён."
msgstr "Profil saqlandi."

#: monday/student.py:1218 monday/teacher.py:1194
msgid "Текущий пароль неверный."
msgstr "Joriy parol noto‘g‘ri."

#: monday/student.py:1220 monday/teacher.py:1196
msgid "Новый пароль должен быть не короче 8 символов."
msgstr "Yangi parol kamida 8 ta belgidan iborat bo‘lishi kerak."

#: monday/student.py:1224 monday/teacher.py:1200
msgid "Пароль изменён."
msgstr "Parol o‘zgartirildi."

#: monday/student.py:1257
msgid "Назови лист, например «CSCA формулы»."
msgstr "Varaqni nomla, masalan «CSCA formulalari»."

#: monday/student.py:1264
msgid "Лист создан. Добавь первую формулу."
msgstr "Varaq yaratildi. Birinchi formulani qo‘sh."

#: monday/student.py:1278
msgid "Лист удалён."
msgstr "Varaq o‘chirildi."

#: monday/student.py:1295 monday/student.py:1312
msgid "Укажи название и формулу или картинку."
msgstr "Nomini va formulani yoki rasmni ko‘rsat."

#: monday/student.py:1307
msgid "Картинка: только PNG, JPG или WEBP."
msgstr "Rasm: faqat PNG, JPG yoki WEBP."

#: monday/teacher.py:111
msgid "Выберите навык: тема → подтема → навык."
msgstr "Ko‘nikmani tanlang: mavzu → bo‘lim → ko‘nikma."

#: monday/teacher.py:114
msgid "Для новой темы укажите и подтему, и навык."
msgstr "Yangi mavzu uchun bo‘limni ham, ko‘nikmani ham ko‘rsating."

#: monday/teacher.py:116
msgid "Для новой подтемы укажите и навык."
msgstr "Yangi bo‘lim uchun ko‘nikmani ham ko‘rsating."

#: monday/teacher.py:122
msgid "Выберите тему для новой подтемы."
msgstr "Yangi bo‘lim uchun mavzuni tanlang."

#: monday/teacher.py:128
msgid "Выберите подтему для нового навыка."
msgstr "Yangi ko‘nikma uchun bo‘limni tanlang."

#: monday/teacher.py:180
msgid "На этот вопрос уже отвечали — убрать нельзя."
msgstr "Bu savolga javob berilgan — olib tashlab bo‘lmaydi."

#: monday/teacher.py:184
msgid "Вопрос дня убран."
msgstr "Kun savoli olib tashlandi."

#: monday/teacher.py:257
msgid "Укажите имя ученика."
msgstr "O‘quvchining ismini kiriting."

#: monday/teacher.py:260
msgid "Время урока в формате ЧЧ:ММ, например 16:00."
msgstr "Dars vaqti SS:DD formatida, masalan 16:00."

#: monday/teacher.py:263
msgid "Неизвестный экзамен."
msgstr "Noma’lum imtihon."

#: monday/teacher.py:296
#, python-format
msgid "Ученик добавлен. Отправьте ему код %(code)s, чтобы подключить его аккаунт."
msgstr "O‘quvchi qo‘shildi. Akkauntini ulash uchun unga %(code)s kodini yuboring."

#: monday/teacher.py:356
msgid "Оценка сохранена."
msgstr "Baho saqlandi."

#: monday/teacher.py:371
msgid "Изменения сохранены."
msgstr "O‘zgarishlar saqlandi."

#: monday/teacher.py:380
msgid "Ученик уже подключён — новый код не нужен."
msgstr "O‘quvchi allaqachon ulangan — yangi kod kerak emas."

#: monday/teacher.py:384
#, python-format
msgid "Новый код: %(code)s. Старый больше не работает."
msgstr "Yangi kod: %(code)s. Eskisi endi ishlamaydi."

#: monday/teacher.py:396
msgid "Аккаунт отвязан. Строка в таблице сохранена."
msgstr "Akkaunt uzildi. Jadvaldagi qator saqlandi."

#: monday/teacher.py:406
msgid "Ученик удалён из таблицы. Его аккаунт и результаты сохранены."
msgstr "O‘quvchi jadvaldan o‘chirildi. Uning akkaunti va natijalari saqlandi."

#: monday/teacher.py:567
msgid "Укажите название."
msgstr "Nomini kiriting."

#: monday/teacher.py:570
msgid "Добавьте хотя бы один вопрос перед публикацией."
msgstr "E’lon qilishdan oldin kamida bitta savol qo‘shing."

#: monday/teacher.py:582
msgid "Большой тест отправлен администратору. Ученики увидят его после одобрения."
msgstr "Katta test administratorga yuborildi. O‘quvchilar uni tasdiqlangandan keyin ko‘radi."

#: monday/teacher.py:586
#, python-format
msgid "Опубликована версия %(n)s. Старые результаты учеников сохранены."
msgstr "%(n)s-versiya e’lon qilindi. O‘quvchilarning eski natijalari saqlandi."

#: monday/teacher.py:588
msgid "Работа опубликована."
msgstr "Ish e’lon qilindi."

#: monday/teacher.py:591 monday/teacher.py:1129
msgid "Черновик сохранён."
msgstr "Qoralama saqlandi."

#: monday/teacher.py:602
msgid "Работа перенесена в архив. Ученики её больше не видят."
msgstr "Ish arxivga ko‘chirildi. O‘quvchilar uni endi ko‘rmaydi."

#: monday/teacher.py:605
msgid "Работа снова опубликована."
msgstr "Ish qayta e’lon qilindi."

#: monday/teacher.py:615
#, python-format
msgid "%(t)s (копия)"
msgstr "%(t)s (nusxa)"

#: monday/teacher.py:621
msgid "Создана копия-черновик."
msgstr "Qoralama-nusxa yaratildi."

#: monday/teacher.py:630
msgid "Опубликованные работы нельзя удалить — перенесите их в архив."
msgstr "E’lon qilingan ishlarni o‘chirib bo‘lmaydi — ularni arxivga ko‘chiring."

#: monday/teacher.py:634
msgid "Черновик удалён."
msgstr "Qoralama o‘chirildi."

#: monday/teacher.py:650
msgid "Выберите опубликованную работу."
msgstr "E’lon qilingan ishni tanlang."

#: monday/teacher.py:655
msgid "Выберите хотя бы одного ученика."
msgstr "Kamida bitta o‘quvchini tanlang."

#: monday/teacher.py:663
msgid "Неверная дата сдачи."
msgstr "Topshirish sanasi noto‘g‘ri."

#: monday/teacher.py:670
#, python-format
msgid "Задание выдано: %(n)s уч."
msgstr "Topshiriq berildi: %(n)s o‘quvchi."

#: monday/teacher.py:672
#, python-format
msgid "Ещё не подключены к Monday: %(names)s. Они увидят задание после ввода кода."
msgstr "Mondayga hali ulanmagan: %(names)s. Ular kodni kiritgandan keyin topshiriqni ko‘radi."

#: monday/teacher.py:736
msgid "Задание снова открыто для проверки."
msgstr "Topshiriq tekshirish uchun qayta ochildi."

#: monday/teacher.py:740
msgid "Проверено. Ученик увидит ваш комментарий."
msgstr "Tekshirildi. O‘quvchi izohingizni ko‘radi."

#: monday/teacher.py:837
msgid "Введите название (минимум 2 символа)."
msgstr "Nom kiriting (kamida 2 ta belgi)."

#: monday/teacher.py:842
msgid "Неверное место в дереве."
msgstr "Daraxtdagi o‘rin noto‘g‘ri."

#: monday/teacher.py:847
#, python-format
msgid "Добавлено: %(name)s."
msgstr "Qo‘shildi: %(name)s."

#: monday/teacher.py:847
msgid "Видно вам и вашим ученикам."
msgstr "Sizga va o‘quvchilaringizga ko‘rinadi."

#: monday/teacher.py:861
#, python-format
msgid "«%(name)s» перенесено в архив. Результаты учеников сохранены."
msgstr "«%(name)s» arxivga ko‘chirildi. O‘quvchilarning natijalari saqlandi."

#: monday/teacher.py:864
msgid "Восстановлено."
msgstr "Tiklandi."

#: monday/teacher.py:877 monday/teacher.py:1191
msgid "Сохранено."
msgstr "Saqlandi."

#: monday/teacher.py:938
msgid "Отметьте хотя бы один вопрос."
msgstr "Kamida bitta savolni belgilang."

#: monday/teacher.py:947
#, python-format
msgid "Вопросов дня на %(d)s: добавлено %(n)s."
msgstr "%(d)s uchun kun savollari: %(n)s ta qo‘shildi."

#: monday/teacher.py:949
#, python-format
msgid "Не добавлено %(n)s: в день не больше 3 вопросов, повторы пропускаются."
msgstr "%(n)s ta qo‘shilmadi: kuniga 3 tadan ortiq savol bo‘lmaydi, takrorlar o‘tkazib yuboriladi."

#: monday/teacher.py:957
#, python-format
msgid "Новая работа · %(n)s вопр."
msgstr "Yangi ish · %(n)s savol"

#: monday/teacher.py:962
#, python-format
msgid "Создана работа из %(n)s вопросов — задайте название и опубликуйте."
msgstr "%(n)s ta savoldan ish yaratildi — nom bering va e’lon qiling."

#: monday/teacher.py:969
#, python-format
msgid "Добавлено в «%(t)s»: %(n)s. Уже были: %(k)s."
msgstr "«%(t)s» ga qo‘shildi: %(n)s. Avvaldan bor edi: %(k)s."

#: monday/teacher.py:969 monday/templates/teacher/bank.html:36
msgid "без названия"
msgstr "nomsiz"

