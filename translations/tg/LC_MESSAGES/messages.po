#: monday/assistant.py:68
msgid "Не нашли ни одного вопроса. Вопросы должны начинаться с номера: «1.» или «1)»."
msgstr "Ягон савол ёфт нашуд. Саволҳо бояд бо рақам оғоз шаванд: «1.» ё «1)»."

#: monday/assistant.py:112 monday/templates/assistant/preview.html:4
msgid "нет текста"
msgstr "матн нест"

#: monday/assistant.py:114
msgid "не выбран навык"
msgstr "малака интихоб нашудааст"

#: monday/assistant.py:116
msgid "не выбран экзамен"
msgstr "имтиҳон интихоб нашудааст"

#: monday/assistant.py:118
msgid "нужно ≥ 2 вариантов и отмеченный верный"
msgstr "≥ 2 вариант ва ҷавоби дурусти қайдшуда лозим аст"

#: monday/assistant.py:120
msgid "ответ должен быть числом"
msgstr "ҷавоб бояд адад бошад"

#: monday/assistant.py:138
msgid "Ничего не сохранено — исправьте отмеченные вопросы или снимите с них галочку."
msgstr "Ҳеҷ чиз нигоҳ дошта нашуд — саволҳои қайдшударо ислоҳ кунед ё қайдро бардоред."

#: monday/assistant.py:144
#, python-format
msgid "Отправлено на проверку: %(n)s. Пропущено: %(s)s."
msgstr "Ба санҷиш фиристода шуд: %(n)s. Гузаронда шуд: %(s)s."

#: monday/assistant.py:146
#, python-format
msgid "Сохранено в черновики: %(n)s."
msgstr "Ба сиёҳнависҳо нигоҳ дошта шуд: %(n)s."

#: monday/assistant.py:148
#, python-format
msgid "Опубликовано в банке: %(n)s. Пропущено: %(s)s."
msgstr "Дар бонк нашр шуд: %(n)s. Гузаронда шуд: %(s)s."

#: monday/assistant.py:150
#, python-format
msgid "Не сохранены (ошибки): %(e)s"
msgstr "Нигоҳ дошта нашуд (хатоҳо): %(e)s"

#: monday/assistant.py:228
msgid "Напишите, что исправить — ассистент увидит комментарий."
msgstr "Нависед, ки чиро ислоҳ кардан лозим — ассистент шарҳро мебинад."

#: monday/assistant.py:246
#, python-format
msgid "Одобрено: %(n)s."
msgstr "Тасдиқ шуд: %(n)s."

#: monday/auth.py:38
msgid "Введите код."
msgstr "Рамзро ворид кунед."

#: monday/auth.py:43
msgid "Код не найден. Проверьте его у учителя."
msgstr "Рамз ёфт нашуд. Онро аз омӯзгор тафтиш кунед."

#: monday/auth.py:45
msgid "Этот код уже использован другим учеником."
msgstr "Ин рамзро хонандаи дигар истифода кардааст."

#: monday/auth.py:48
msgid "Вы уже подключены к этому учителю."
msgstr "Шумо аллакай ба ин омӯзгор пайваст ҳастед."

#: monday/auth.py:54
#, python-format
msgid "Вы подключены к учителю: %(name)s."
msgstr "Шумо ба омӯзгор пайваст шудед: %(name)s."

#: monday/auth.py:72
msgid "Неверный email или пароль."
msgstr "Email ё парол нодуруст аст."

#: monday/auth.py:75
msgid "Аккаунт заблокирован. Напишите администратору."
msgstr "Аккаунт манъ шудааст. Ба администратор нависед."

#: monday/auth.py:91
msgid "Вход через Google заработает после подключения ключей Google. Пока войдите по email."
msgstr "Воридшавӣ бо Google пас аз пайваст кардани калидҳои Google кор мекунад. Ҳоло бо email ворид шавед."

#: monday/auth.py:93
msgid "Вход через Google скоро появится."
msgstr "Воридшавӣ бо Google ба зудӣ пайдо мешавад."

#: monday/auth.py:109
msgid "Укажите имя."
msgstr "Номро нишон диҳед."

#: monday/auth.py:111
msgid "Укажите корректный email."
msgstr "Email-и дурустро нишон диҳед."

#: monday/auth.py:113
msgid "Пароль должен быть не короче 8 символов."
msgstr "Парол бояд на камтар аз 8 аломат бошад."

#: monday/auth.py:115
msgid "Этот email уже зарегистрирован."
msgstr "Ин email аллакай сабт шудааст."

#: monday/auth.py:143
msgid "Код приглашения не найден."
msgstr "Рамзи даъват ёфт нашуд."

#: monday/auth.py:147
msgid "Код приглашения предназначен для ученика."
msgstr "Рамзи даъват барои хонанда аст."

#: monday/auth.py:153
#, python-format
msgid "%(name)s приглашает вас в Monday. Зарегистрируйтесь или войдите — код подключится автоматически."
msgstr "%(name)s шуморо ба Monday даъват мекунад. Сабт шавед ё ворид шавед — рамз худкор пайваст мешавад."

#: monday/auth.py:215
msgid "Фото удалено."
msgstr "Акс нест карда шуд."

#: monday/auth.py:219
msgid "Выберите фото."
msgstr "Акс интихоб кунед."

#: monday/auth.py:223
msgid "Фото: только PNG, JPG или WEBP."
msgstr "Акс: танҳо PNG, JPG ё WEBP."

#: monday/auth.py:228
msgid "Фото обновлено."
msgstr "Акс нав карда шуд."

#: monday/bank.py:169
