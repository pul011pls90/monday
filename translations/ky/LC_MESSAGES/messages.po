#: monday/assistant.py:68
msgid "Не нашли ни одного вопроса. Вопросы должны начинаться с номера: «1.» или «1)»."
msgstr "Бир да суроо табылган жок. Суроолор номер менен башталышы керек: «1.» же «1)»."

#: monday/assistant.py:112 monday/templates/assistant/preview.html:4
msgid "нет текста"
msgstr "текст жок"

#: monday/assistant.py:114
msgid "не выбран навык"
msgstr "көндүм тандалган жок"

#: monday/assistant.py:116
msgid "не выбран экзамен"
msgstr "экзамен тандалган жок"

#: monday/assistant.py:118
msgid "нужно ≥ 2 вариантов и отмеченный верный"
msgstr "≥ 2 вариант жана белгиленген туура жооп керек"

#: monday/assistant.py:120
msgid "ответ должен быть числом"
msgstr "жооп сан болушу керек"

#: monday/assistant.py:138
msgid "Ничего не сохранено — исправьте отмеченные вопросы или снимите с них галочку."
msgstr "Эч нерсе сакталган жок — белгиленген суроолорду оңдоңуз же алардан белгини алып салыңыз."

#: monday/assistant.py:144
#, python-format
msgid "Отправлено на проверку: %(n)s. Пропущено: %(s)s."
msgstr "Текшерүүгө жөнөтүлдү: %(n)s. Өткөрүлүп жиберилди: %(s)s."

#: monday/assistant.py:146
#, python-format
msgid "Сохранено в черновики: %(n)s."
msgstr "Долбоорго сакталды: %(n)s."

#: monday/assistant.py:148
#, python-format
msgid "Опубликовано в банке: %(n)s. Пропущено: %(s)s."
msgstr "Банкка жарыяланды: %(n)s. Өткөрүлүп жиберилди: %(s)s."

#: monday/assistant.py:150
#, python-format
msgid "Не сохранены (ошибки): %(e)s"
msgstr "Сакталган жок (каталар): %(e)s"

#: monday/assistant.py:228
msgid "Напишите, что исправить — ассистент увидит комментарий."
msgstr "Эмнени оңдоо керектигин жазыңыз — ассистент комментарийди көрөт."

#: monday/assistant.py:246
#, python-format
msgid "Одобрено: %(n)s."
msgstr "Жактырылды: %(n)s."

#: monday/auth.py:38
msgid "Введите код."
msgstr "Кодду киргизиңиз."

#: monday/auth.py:43
msgid "Код не найден. Проверьте его у учителя."
msgstr "Код табылган жок. Аны мугалимден текшериңиз."

#: monday/auth.py:45
msgid "Этот код уже использован другим учеником."
msgstr "Бул кодду башка окуучу колдонуп койгон."

#: monday/auth.py:48
msgid "Вы уже подключены к этому учителю."
msgstr "Сиз бул мугалимге буга чейин туташкансыз."

#: monday/auth.py:54
#, python-format
msgid "Вы подключены к учителю: %(name)s."
msgstr "Сиз мугалимге туташтыңыз: %(name)s."

#: monday/auth.py:72
msgid "Неверный email или пароль."
msgstr "Email же сырсөз туура эмес."

#: monday/auth.py:75
msgid "Аккаунт заблокирован. Напишите администратору."
msgstr "Аккаунт бөгөттөлгөн. Администраторго жазыңыз."

#: monday/auth.py:91
msgid "Вход через Google заработает после подключения ключей Google. Пока войдите по email."
msgstr "Google аркылуу кирүү Google ачкычтары туташтырылгандан кийин иштейт. Азырынча email менен кириңиз."

#: monday/auth.py:93
msgid "Вход через Google скоро появится."
msgstr "Google аркылуу кирүү жакында пайда болот."

#: monday/auth.py:109
msgid "Укажите имя."
msgstr "Атыңызды жазыңыз."

#: monday/auth.py:111
msgid "Укажите корректный email."
msgstr "Туура email жазыңыз."

#: monday/auth.py:113
msgid "Пароль должен быть не короче 8 символов."
msgstr "Сырсөз 8 белгиден кыска болбошу керек."

#: monday/auth.py:115
msgid "Этот email уже зарегистрирован."
msgstr "Бул email мурун катталган."

#: monday/auth.py:143
msgid "Код приглашения не найден."
msgstr "Чакыруу коду табылган жок."

#: monday/auth.py:147
msgid "Код приглашения предназначен для ученика."
msgstr "Чакыруу коду окуучу үчүн арналган."

#: monday/auth.py:153
#, python-format
msgid "%(name)s приглашает вас в Monday. Зарегистрируйтесь или войдите — код подключится автоматически."
msgstr "%(name)s сизди Mondayга чакырат. Катталыңыз же кириңиз — код автоматтык түрдө туташат."

#: monday/auth.py:215
msgid "Фото удалено."
msgstr "Сүрөт өчүрүлдү."

#: monday/auth.py:219
msgid "Выберите фото."
msgstr "Сүрөт тандаңыз."

#: monday/auth.py:223
msgid "Фото: только PNG, JPG или WEBP."
msgstr "Сүрөт: PNG, JPG же WEBP гана."

#: monday/auth.py:228
msgid "Фото обновлено."
msgstr "Сүрөт жаңыртылды."

#: monday/bank.py:169
msgid "По этим фильтрам вопросов нет. Сними часть фильтров."
msgstr "Бул чыпкалар боюнча суроо жок. Чыпкалардын бир бөлүгүн алып сал."

