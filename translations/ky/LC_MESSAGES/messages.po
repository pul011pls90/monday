#: monday/admin.py:181
#, python-format
msgid "Заявка отклонена: %(name)s теперь ученик."
msgstr "Арыз четке кагылды: %(name)s эми окуучу."

#: monday/admin.py:183
#, python-format
msgid "%(name)s подтверждён как учитель."
msgstr "%(name)s мугалим катары тастыкталды."

#: monday/admin.py:194
msgid "Нельзя менять собственную роль."
msgstr "Өз ролуңузду өзгөртө албайсыз."

#: monday/admin.py:201
#, python-format
msgid "%(name)s: роль изменена."
msgstr "%(name)s: ролу өзгөртүлдү."

#: monday/admin.py:213
#, python-format
msgid "%(name)s теперь методист: проверяет вопросы ассистентов."
msgstr "%(name)s эми методист: ассистенттердин суроолорун текшерет."

#: monday/admin.py:214
#, python-format
msgid "%(name)s больше не методист."
msgstr "%(name)s мындан ары методист эмес."

#: monday/admin.py:223
msgid "Нельзя заблокировать себя."
msgstr "Өзүңүздү бөгөттөй албайсыз."

#: monday/admin.py:227
#, python-format
msgid "%(name)s заблокирован."
msgstr "%(name)s бөгөттөлдү."

#: monday/admin.py:227
#, python-format
